<Window x:Class="TsuruNoHitokoe.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一声帳 ― ツルの一声"
        Width="600" Height="680" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="#F4EEE2" UseLayoutRounding="True"
        FontFamily="Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#FBF7EE" />
        <SolidColorBrush x:Key="Edge" Color="#DDD0BA" />
        <SolidColorBrush x:Key="Ink" Color="#2A2420" />
        <SolidColorBrush x:Key="Muted" Color="#8C7F6C" />
        <SolidColorBrush x:Key="Shu" Color="#C8382A" />

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#FFF8EE" />
            <Setter Property="Background" Value="{StaticResource Shu}" />
            <Setter Property="BorderBrush" Value="{StaticResource Shu}" />
        </Style>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                       Foreground="{StaticResource Muted}" Text="112 件" />
            <StackPanel>
                <TextBlock Text="一声帳" FontFamily="Yu Mincho" FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource Ink}" />
                <TextBlock Text="ツルが話す雑学の一覧です。そのまま書き換えたり、消したり、書き足したりできます。"
                           Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- 追加 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewText" Style="{StaticResource Field}" FontFamily="Yu Mincho" FontSize="14"
                     ToolTip="新しい一声を書いて Enter で追加" />
            <TextBlock x:Name="NewHint" Text="新しい一声を書いて Enter …" IsHitTestVisible="False"
                       Foreground="#B5A893" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Yu Mincho" FontSize="14" />
            <Button x:Name="AddButton" Grid.Column="1" Content="追加" Style="{StaticResource Primary}" Margin="8,0,0,0" />
        </Grid>

        <!-- 検索 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBox x:Name="SearchText" Style="{StaticResource Field}" Padding="28,5,8,5" />
            <TextBlock Text="⌕" Foreground="{StaticResource Muted}" Margin="10,0,0,1" VerticalAlignment="Center"
                       FontSize="15" IsHitTestVisible="False" />
            <TextBlock x:Name="SearchHint" Text="さがす" IsHitTestVisible="False" Foreground="#B5A893"
                       Margin="29,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- 一覧 -->
        <Border Grid.Row="3" Background="{StaticResource Paper}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         KeyboardNavigation.TabNavigation="Continue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border BorderBrush="#ECE3D3" BorderThickness="0,0,0,1" Padding="10,4,4,4">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" Padding="0,5"
                                         FontFamily="Yu Mincho" FontSize="14" Foreground="#2A2420"
                                         VerticalContentAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Background" Value="#FFFDF8" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="1" Content="✕" Style="{StaticResource IconBtn}" VerticalAlignment="Center"
                                        ToolTip="この一声を消す" Click="Delete_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="見つかりませんでした" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ボタン -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="デフォルトに戻す" Style="{StaticResource Btn}"
                    Foreground="{StaticResource Muted}" ToolTip="編集をすべて取り消して、最初から入っている雑学に戻します" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存" Style="{StaticResource Primary}"
                    Margin="8,0,0,0" MinWidth="84" ToolTip="保存 (Ctrl+S)" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="閉じる" Style="{StaticResource Btn}" MinWidth="84" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{StaticResource Muted}" />
        </DockPanel>
    </Grid>
</Window>
