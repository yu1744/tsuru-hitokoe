<Window x:Class="TsuruNoHitokoe.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ツルの一声"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" Cursor="Hand"
        ToolTip="クリックで閉じる">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#FBF7EE" />
        <SolidColorBrush x:Key="Edge" Color="#DDD0BA" />
    </Window.Resources>

    <Border x:Name="Outer" Padding="14" Background="Transparent">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>

        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <Border x:Name="Card" MinWidth="80" MaxWidth="300" Margin="0,9" Background="{StaticResource Paper}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="10"
                    Padding="18,13,18,13">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#3A2A1A" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap"
                               Foreground="#2A2420" FontFamily="Yu Mincho" FontSize="15"
                               LineHeight="26" LineStackingStrategy="BlockLineHeight" />

                    <!-- ニュースのときだけ: 出典・時刻と「続きを読む」 -->
                    <DockPanel x:Name="Footer" Margin="0,6,0,-3" Visibility="Collapsed" LastChildFill="True">
                        <Button x:Name="MoreButton" DockPanel.Dock="Right" Margin="12,0,-6,0"
                                Focusable="False" Cursor="Hand" ToolTip="ブラウザで開く" Content="続きを読む ›">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="Label" Foreground="#C8382A"
                                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F3E6D6" />
                                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="MetaText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="#9A8D7B" FontFamily="Yu Gothic UI" FontSize="11.5" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- しっぽ (ツルのいる側だけ表示) -->
            <Path x:Name="TailTop" VerticalAlignment="Top" HorizontalAlignment="Left" Width="16" Height="10"
                  Data="M0,10 L8,0 L16,10" Fill="{StaticResource Paper}" Stroke="{StaticResource Edge}" StrokeThickness="1" />
            <Path x:Name="TailBottom" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="16" Height="10"
                  Data="M0,0 L8,10 L16,0" Fill="{StaticResource Paper}" Stroke="{StaticResource Edge}" StrokeThickness="1" />
        </Grid>
    </Border>
</Window>
