<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TsuruNoHitokoe</AssemblyName>
    <RootNamespace>TsuruNoHitokoe</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>

    <Product>ツルの一声</Product>
    <AssemblyTitle>ツルの一声</AssemblyTitle>
    <Description>画面のツルをクリックすると雑学をひとつ教えてくれる常駐アプリ</Description>
    <Version>1.0.0</Version>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <!-- 配布用: dotnet publish -c Release で単一 exe (ランタイム同梱) を出力 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\trivia.json" LogicalName="trivia.json" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tsuru.png" />
  </ItemGroup>

  <!--
    ツルのイラスト (いらすとや) は素材の再配布にあたるためリポジトリに含めていない。
    ビルド前に Assets\tsuru.png を用意してもらい、アイコンはそこから自動で作る。
  -->
  <Target Name="PrepareTsuruAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Assets\tsuru.png')"
           Text="Assets\tsuru.png がありません。README.md の「ビルド方法」に従って、いらすとやのツルのイラスト (animal_tsuru.png) をダウンロードし、Assets\tsuru.png として保存してください。" />
    <Exec Condition="!Exists('Assets\app.ico')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\make_icon.ps1&quot;" />
  </Target>

</Project>
